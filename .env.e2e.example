# Variables de entorno para tests E2E con Playwright
# Copiar a .env.e2e y ajustar según el entorno

# URL del frontend a testear
FRONTEND_URL=https://consessio-front.vercel.app
# o para local:
# FRONTEND_URL=http://localhost:5173

# URL del backend (para setup/teardown via API)
API_BASE_URL=https://api-consessio-production.up.railway.app
# o para local:
# API_BASE_URL=http://localhost:8080

# Credenciales de usuario de prueba (ya creado en producción)
# Para tests de login y flujos que requieren sesión
E2E_ADMIN_EMAIL=admin@example.com
E2E_ADMIN_PASSWORD=Test1234!
